import json

FILE_NAME = "library.json"


# ------------------------------------------
# Load library records from file
# ------------------------------------------
def load_books():
    try:
        with open(FILE_NAME, "r") as file:
            return json.load(file)
    except FileNotFoundError:
        return []


# ------------------------------------------
# Save library records to file
# ------------------------------------------
def save_books(books):
    with open(FILE_NAME, "w") as file:
        json.dump(books, file, indent=4)

    print("\nRecords saved successfully!")


# ------------------------------------------
# Add a new book
# ------------------------------------------
def add_book(books):

    book_id = input("Enter Book ID: ")

    # Check whether Book ID already exists
    for book in books:
        if book["id"] == book_id:
            print("Book ID already exists!")
            return

    title = input("Enter Book Title: ")
    author = input("Enter Author Name: ")

    book = {
        "id": book_id,
        "title": title,
        "author": author,
        "status": "Available",
        "issued_to": ""
    }

    books.append(book)

    print("\nBook added successfully!")


# ------------------------------------------
# Search for a book
# ------------------------------------------
def search_book(books):

    book_id = input("Enter Book ID to search: ")

    for book in books:

        if book["id"] == book_id:

            print("\nBook Found!")
            print("-------------------------")
            print("Book ID    :", book["id"])
            print("Title      :", book["title"])
            print("Author     :", book["author"])
            print("Status     :", book["status"])

            if book["status"] == "Issued":
                print("Issued To  :", book["issued_to"])

            return

    print("\nBook not found.")


# ------------------------------------------
# Issue a book
# ------------------------------------------
def issue_book(books):

    book_id = input("Enter Book ID to issue: ")

    for book in books:

        if book["id"] == book_id:

            if book["status"] == "Issued":
                print("\nBook is already issued.")
                print("Issued To :", book["issued_to"])
                return

            student_name = input("Enter Student Name: ")

            book["status"] = "Issued"
            book["issued_to"] = student_name

            print("\nBook issued successfully!")

            return

    print("\nBook not found.")


# ------------------------------------------
# Return a book
# ------------------------------------------
def return_book(books):

    book_id = input("Enter Book ID to return: ")

    for book in books:

        if book["id"] == book_id:

            if book["status"] == "Available":
                print("\nBook is already available.")
                return

            book["status"] = "Available"
            book["issued_to"] = ""

            print("\nBook returned successfully!")

            return

    print("\nBook not found.")


# ------------------------------------------
# Display available books
# ------------------------------------------
def display_available_books(books):

    available_books = []

    for book in books:

        if book["status"] == "Available":
            available_books.append(book)

    if len(available_books) == 0:
        print("\nNo books are currently available.")
        return

    print("\n========== AVAILABLE BOOKS ==========")

    for book in available_books:

        print("\nBook ID    :", book["id"])
        print("Title      :", book["title"])
        print("Author     :", book["author"])
        print("Status     :", book["status"])

    print("\n=====================================")


# ------------------------------------------
# Display all books
# ------------------------------------------
def display_all_books(books):

    if len(books) == 0:
        print("\nNo books found.")
        return

    print("\n========== ALL BOOKS ==========")

    for book in books:

        print("\nBook ID    :", book["id"])
        print("Title      :", book["title"])
        print("Author     :", book["author"])
        print("Status     :", book["status"])

        if book["status"] == "Issued":
            print("Issued To  :", book["issued_to"])

    print("\n===============================")


# ------------------------------------------
# Main Menu
# ------------------------------------------
def main():

    books = load_books()

    while True:

        print("\n")
        print("======================================")
        print("       LIBRARY MANAGEMENT SYSTEM")
        print("======================================")

        print("1. Add Book")
        print("2. Search Book")
        print("3. Issue Book")
        print("4. Return Book")
        print("5. Display Available Books")
        print("6. Display All Books")
        print("7. Save Records")
        print("8. Exit")

        print("======================================")

        choice = input("Enter your choice (1-8): ")

        if choice == "1":
            add_book(books)

        elif choice == "2":
            search_book(books)

        elif choice == "3":
            issue_book(books)

        elif choice == "4":
            return_book(books)

        elif choice == "5":
            display_available_books(books)

        elif choice == "6":
            display_all_books(books)

        elif choice == "7":
            save_books(books)

        elif choice == "8":

            save_books(books)

            print("\nThank you for using Library Management System!")
            break

        else:
            print("\nInvalid choice! Please enter a number from 1 to 8.")


# ------------------------------------------
# Run the program
# ------------------------------------------
if __name__ == "__main__":
    main()
